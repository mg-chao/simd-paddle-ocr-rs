<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Sdcb.SimdPaddleOCR.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <Target Name="RequireReferenceRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ReferenceRoot)/src/Sdcb.SimdPaddleOCR/Sdcb.SimdPaddleOCR.csproj')"
           Text="Pass -p:ReferenceRoot=ABSOLUTE_PATH_TO_PINNED_SIMDPADDLEOCR_CHECKOUT." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(ReferenceRoot)/src/Sdcb.SimdPaddleOCR/Sdcb.SimdPaddleOCR.csproj" />
  </ItemGroup>
</Project>
