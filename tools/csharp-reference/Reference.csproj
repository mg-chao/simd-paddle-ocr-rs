    <InvariantGlobalization>true</InvariantGlobalization>
    <SimdPaddleOcrRoot Condition="'$(SimdPaddleOcrRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\SimdPaddleOCR</SimdPaddleOcrRoot>
