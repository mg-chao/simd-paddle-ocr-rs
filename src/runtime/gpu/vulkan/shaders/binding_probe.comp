#version 450 core
layout(local_size_x=1,local_size_y=1,local_size_z=1) in;
layout(std430,set=0,binding=0) readonly buffer Input {float input_data[];};
layout(std430,set=0,binding=1) buffer Output {float output_data[];};
layout(std140,set=0,binding=2) uniform Params {uvec4 words[32];};
void main(){output_data[0]=input_data[0]+float(words[0].x);}
