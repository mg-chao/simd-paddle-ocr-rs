#version 450 core
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "storage.glsl"
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Features { STORAGE_0 features[]; };
layout(set=0,binding=1,std430) readonly buffer Weights { float weights[]; };
layout(set=0,binding=2,std430) readonly buffer Bias { float bias[]; };
layout(set=0,binding=3,std430) buffer Partials { uvec4 partials[]; };
layout(set=0,binding=4,std140) uniform Params { uvec4 words[64]; };
// Admission requires a 32- or 64-lane subgroup. Leaders initialize every
// shared element that is read; no zero-initialized workgroup memory is assumed.
shared vec4 maxima[2];
shared uvec4 winners[2];
shared uvec4 errors[2];
shared vec4 sums[2];
void main() {
    uint rows=words[0].x, inner=words[0].y, classes=words[0].z, tiles=words[0].w;
    uint row=gl_WorkGroupID.y*4, column=gl_WorkGroupID.x*64+gl_LocalInvocationIndex;
    vec4 value=vec4(-3.402823e38);
    if(column<classes) {
        value=vec4(bias[column]);
        for(uint k=0;k<inner;k++) {
            float weight=weights[k*classes+column];
            for(uint r=0;r<4;r++) if(row+r<rows) value[r]+=float(features[(row+r)*inner+k])*weight;
        }
    }
    vec4 maximum=subgroupMax(value);
    uvec4 winner=subgroupMin(mix(uvec4(0xffffffffu),uvec4(column),equal(value,maximum)));
    uvec4 invalid=subgroupOr(uvec4(isnan(value))|uvec4(greaterThan(abs(value),vec4(3.402823e38))));
    if(subgroupElect()) {maxima[gl_SubgroupID]=maximum; winners[gl_SubgroupID]=winner; errors[gl_SubgroupID]=invalid;}
    barrier();
    maximum=maxima[0]; winner=winners[0]; invalid=errors[0];
    for(uint s=1;s<gl_NumSubgroups;s++) {
        for(uint r=0;r<4;r++) if(maxima[s][r]>maximum[r] || (maxima[s][r]==maximum[r] && winners[s][r]<winner[r])) {maximum[r]=maxima[s][r]; winner[r]=winners[s][r];}
        invalid|=errors[s];
    }
    vec4 sum=vec4(0.0);
    if(words[1].x!=0u) {
        sum=subgroupAdd(column<classes?exp(value-maximum):vec4(0.0));
        if(subgroupElect()) sums[gl_SubgroupID]=sum;
        barrier();
        sum=sums[0];
        for(uint s=1;s<gl_NumSubgroups;s++) sum+=sums[s];
    }
    if(gl_LocalInvocationIndex==0u) for(uint r=0;r<4;r++) if(row+r<rows) partials[(row+r)*tiles+gl_WorkGroupID.x]=uvec4(winner[r],floatBitsToUint(maximum[r]),floatBitsToUint(sum[r]),invalid[r]);
}
