#version 450 core
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
#include "neural.glsl"

shared float partial[64];
shared float tile[1024];

// Vulkan permits reciprocal-multiply lowering. Recover the residual of the
// rounded quotient before returning a float, as in the CPU division.
float spatial_average(float sum, uint plane) {
    float divisor = float(plane);
    float q = uintBitsToFloat(floatBitsToUint(sum / divisor) & p(7u));
    if (isinf(q) || isnan(q))
        return q;
    precise float residual = fma(-q, divisor, sum);
    return fma(residual, 1. / divisor, q);
}

// Contiguous spatial ReduceMean uses two independent four-float packets.
// Read ahead within each of the eight independent accumulator chains.
void spatial_mean(uint row, uint lane, uint plane, bool global_pool) {
    uint base = row * plane;
    uint prefix = global_pool ? 0u : (0u - base) % 4u;
    uint packets = (plane - prefix) / 4u;
    bool arm_order = p(5u) != 0u;
    precise float sum = 0.;
    if (global_pool && !arm_order) {
        for (uint start = 0u; start < plane; start += 1024u) {
            uint count = min(1024u, plane - start);
            for (uint j = lane; j < count; j += 64u)
                tile[j] = load_a(base + start + j);
            barrier();
            if (lane == 0u)
                for (uint j = 0u; j < count; ++j)
                    sum += tile[j];
            barrier();
        }
        if (lane == 0u)
            store_output(row, spatial_average(sum, plane));
        return;
    }
    // ARM GlobalAveragePool uses one four-lane packet, ReduceMean uses two.
    uint stride = global_pool ? 4u : 8u;
    uint length = (plane - prefix) / stride * stride;
    if (lane < stride) {
        uint j = lane;
        for (; j + 15u * stride < length; j += 16u * stride) {
            [[unroll]] for (uint k = 0u; k < 16u; ++k)
                sum += load_a(base + prefix + j + stride * k);
        }
        for (; j < length; j += stride)
            sum += load_a(base + prefix + j);
    }
    partial[lane] = sum;
    barrier();
    if (lane < 4u && !global_pool) {
        precise float merged = partial[lane] + partial[lane + 4u];
        if ((packets & 1u) != 0u)
            merged += load_a(base + prefix + length + lane);
        partial[lane] = merged;
    }
    barrier();
    if (lane == 0u) {
        precise float total = arm_order ? (partial[0] + partial[1]) + (partial[2] + partial[3])
                                        : (partial[0] + partial[2]) + (partial[1] + partial[3]);
        for (uint j = 0u; j < prefix; ++j)
            total += load_a(base + j);
        for (uint j = prefix + 4u * packets; j < plane; ++j)
            total += load_a(base + j);
        store_output(row, spatial_average(total, plane));
    }
}
void main() {
    uint row = gl_WorkGroupID.x + gl_WorkGroupID.y * p(1u);
    if (row >= p(0u))
        return;
    uint lane = gl_LocalInvocationIndex, plane = p(3u);
    if (p(6u) != 0u) {
        spatial_mean(row, lane, plane, p(6u) == 2u);
        return;
    }
    float sum = 0.;
    for (uint i = lane; i < plane; i += 64u)
        sum += load_a(row * plane + i);
    partial[lane] = sum;
    barrier();
    for (uint stride = 32u; stride > 0u; stride /= 2u) {
        if (lane < stride)
            partial[lane] += partial[lane + stride];
        barrier();
    }
    if (lane == 0u)
        store_output(row, partial[0] / float(plane));
}
