#version 450 core
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
#include "storage.glsl"

struct Params {
    uvec4 words[64];
};
layout(std430, set = 0, binding = 0) readonly buffer type_3_block_0Compute { uint _group_0_binding_0_cs[]; };

layout(std430, set = 0, binding = 1) buffer type_3_block_1Compute { uint _group_0_binding_1_cs[]; };

layout(std140, set = 0, binding = 2) uniform Params_block_2Compute { Params _group_0_binding_2_cs; };

uint p(uint i_2) {
    uint _e9 = _group_0_binding_2_cs.words[(i_2 / 4u)][(i_2 % 4u)];
    return _e9;
}

// Sort compact indices before copying the full records. The candidate index is
// the reverse raster contour order, so it also breaks stable equal-y ties.
#define inputBoxes _group_0_binding_0_cs
#define outputBoxes _group_0_binding_1_cs
uint slot(uint i) { return (i+1u)*16u+15u; }
float coord(uint id,uint axis) { return uintBitsToFloat(inputBoxes[id*16u+axis]); }
bool before(uint a,uint b,bool row) {
    if (row && coord(a,0u)!=coord(b,0u)) return coord(a,0u)<coord(b,0u);
    return coord(a,1u)!=coord(b,1u) ? coord(a,1u)<coord(b,1u) : a<b;
}
void sift(uint start,uint n,uint i,bool row) {
    uint value=outputBoxes[slot(start+i)];
    while (2u*i+1u<n) {
        uint child=2u*i+1u;
        if (child+1u<n && before(outputBoxes[slot(start+child)],outputBoxes[slot(start+child+1u)],row)) ++child;
        uint next=outputBoxes[slot(start+child)];
        if (!before(value,next,row)) break;
        outputBoxes[slot(start+i)]=next; i=child;
    }
    outputBoxes[slot(start+i)]=value;
}
void sort_indices(uint start,uint n,bool row) {
    for (uint k=n/2u; k>0u; --k) sift(start,n,k-1u,row);
    for (uint k=n; k>1u; --k) {
        uint last=slot(start+k-1u), first=slot(start);
        uint v=outputBoxes[first]; outputBoxes[first]=outputBoxes[last]; outputBoxes[last]=v;
        sift(start,k-1u,0u,row);
    }
}
void main() {
    uint n=0u;
    for (uint i=0u;i<p(0u);++i)
        if (inputBoxes[i*16u+9u]!=0u) outputBoxes[slot(n++)]=i;
    sort_indices(0u,n,false);
    for (uint start=0u; start<n;) {
        uint end=start+1u;
        while (end<n && coord(outputBoxes[slot(end)],1u)-coord(outputBoxes[slot(end-1u)],1u)<10.) ++end;
        sort_indices(start,end-start,true);
        start=end;
    }
    for (uint i=0u;i<n;++i) {
        uint id=outputBoxes[slot(i)];
        for (uint k=0u;k<16u;++k) outputBoxes[(i+1u)*16u+k]=inputBoxes[id*16u+k];
    }
    outputBoxes[0]=n;
}
